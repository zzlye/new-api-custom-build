          "status": "status",
          "url": "metadata.url",
          "error": "error.message|error|message",
          "progress": "progress",
          "states": {
            "queued": "queued",
            "in_progress": "in_progress",
            "completed": "completed",
            "failed": "failed"
          }
        }
